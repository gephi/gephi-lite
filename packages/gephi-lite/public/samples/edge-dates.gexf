<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" xmlns:viz="http://gexf.net/1.3/viz" version="1.3">
  <meta>
    <creator>Gephi Lite</creator>
    <description>A fictional research collaboration network with dated edges from 2022 through 2025.</description>
  </meta>
  <graph defaultedgetype="undirected" mode="static" name="Research collaborations over time">
    <attributes class="edge" mode="static">
      <attribute id="createdAt" title="Collaboration date" type="string" />
      <attribute id="project" title="Project" type="string" />
      <attribute id="weight" title="Publications" type="float" />
    </attributes>
    <nodes>
