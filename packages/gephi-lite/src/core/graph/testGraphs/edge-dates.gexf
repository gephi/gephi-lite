<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" version="1.3">
  <graph defaultedgetype="directed" mode="static">
    <attributes class="edge" mode="static">
      <attribute id="createdAt" title="createdAt" type="string" />
    </attributes>
    <nodes>
      <node id="n1" label="One" />
      <node id="n2" label="Two" />
      <node id="n3" label="Three" />
      <node id="n4" label="Four" />
    </nodes>
    <edges>
      <edge id="before" source="n1" target="n2">
        <attvalues><attvalue for="createdAt" value="2024-12-31" /></attvalues>
      </edge>
      <edge id="inside" source="n2" target="n3">
        <attvalues><attvalue for="createdAt" value="2025-01-15" /></attvalues>
      </edge>
      <edge id="after" source="n3" target="n4">
        <attvalues><attvalue for="createdAt" value="2025-02-01" /></attvalues>
      </edge>
      <edge id="missing" source="n1" target="n4" />
    </edges>
  </graph>
</gexf>
