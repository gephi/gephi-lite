# Enables the "PRÉ-PRODUCTION" badge (see src/components/PreproductionBanner.tsx).
# This value is branch-specific: "true" on `develop` (pre-production), "false" on `main_jg`
# (production). Being a checked-in file rather than only a CI-provided variable, it also takes
# effect for local dev builds on either branch, without needing the CI/CD pipeline.
VITE_PREPRODUCTION=true
